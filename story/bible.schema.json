{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/boeing23/tarantino/story/bible.schema.json",
  "title": "Story Bible",
  "description": "Everything the engine needs to run one live story. Fields are add-only: never rename or remove once downstream code reads them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "world",
    "moods",
    "style",
    "characters",
    "opening",
    "beats",
    "endings",
    "forbidden",
    "state_seed",
    "bridges",
    "audience_hooks"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Stable snake_case identifier. Never rename once used."
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speaker",
        "text"
      ],
      "properties": {
        "speaker": {
          "$ref": "#/$defs/id",
          "description": "A character id, or \"narrator\"."
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "motion"
      ],
      "description": "One video shot. `frame` describes the first frame (keyframe for image-to-video); `motion` describes what moves and how the camera moves.",
      "properties": {
        "frame": {
          "$ref": "#/$defs/text"
        },
        "motion": {
          "$ref": "#/$defs/text"
        },
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "Characters in frame; their reference images are passed to the video model for consistency."
        },
        "line": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "speaker",
            "text"
          ],
          "description": "At most one spoken line per shot; the video model voices it.",
          "properties": {
            "speaker": {
              "$ref": "#/$defs/id",
              "description": "A character id, or \"narrator\"."
            },
            "text": {
              "$ref": "#/$defs/text",
              "description": "15 words or fewer."
            }
          }
        },
        "sound": {
          "$ref": "#/$defs/text",
          "description": "Ambience and sound effects for this shot."
        }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeholder",
        "title",
        "logline",
        "genre",
        "rating",
        "target_runtime_min",
        "beat_seconds",
        "lock_seconds_before_end"
      ],
      "properties": {
        "placeholder": {
          "type": "boolean",
          "description": "true for the stand-in story. Must be false before the demo."
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "logline": {
          "$ref": "#/$defs/text",
          "description": "One sentence: who wants what, and what stands in the way."
        },
        "genre": {
          "$ref": "#/$defs/text"
        },
        "rating": {
          "enum": [
            "G",
            "PG",
            "PG-13",
            "R"
          ]
        },
        "target_runtime_min": {
          "type": "number",
          "minimum": 1,
          "maximum": 30
        },
        "beat_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 240,
          "description": "Target playback length of one chapter (beat). Comments steer the next one."
        },
        "lock_seconds_before_end": {
          "type": "integer",
          "minimum": 10,
          "maximum": 180,
          "description": "Comments lock this many seconds before the chapter ends, leaving time to write and render the next one. Must be less than beat_seconds."
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place",
        "time",
        "tone",
        "rules"
      ],
      "properties": {
        "place": {
          "$ref": "#/$defs/text"
        },
        "time": {
          "$ref": "#/$defs/text"
        },
        "tone": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 3,
          "maxItems": 5,
          "description": "Adjectives the writer must stay inside, e.g. tense, wry, intimate."
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "description": "Facts that are always true in this world (no phones work, nobody can leave, ...)."
        }
      }
    },
    "moods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 3,
      "uniqueItems": true,
      "description": "Closed mood vocabulary. Aggregation must map the crowd to one of these; endings trigger on them."
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_prompt",
        "camera",
        "lighting",
        "motion",
        "negative_prompt",
        "aspect_ratio",
        "clip_seconds"
      ],
      "properties": {
        "visual_prompt": {
          "$ref": "#/$defs/text",
          "description": "Prefix added to every shot so all clips share one look."
        },
        "camera": {
          "$ref": "#/$defs/text"
        },
        "lighting": {
          "$ref": "#/$defs/text"
        },
        "motion": {
          "$ref": "#/$defs/text",
          "description": "Default motion language, e.g. slow push-in, subtle handheld sway."
        },
        "negative_prompt": {
          "type": "string"
        },
        "aspect_ratio": {
          "enum": [
            "16:9",
            "9:16",
            "1:1",
            "21:9"
          ]
        },
        "clip_seconds": {
          "type": "integer",
          "minimum": 3,
          "maximum": 20,
          "description": "Length of one generated clip."
        }
      },
      "description": "Shared look and motion for every clip."
    },
    "characters": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "role",
          "want",
          "secret",
          "voice",
          "portrait_prompt",
          "can_die_after_beat"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "role": {
            "enum": [
              "protagonist",
              "antagonist",
              "ally",
              "wildcard"
            ]
          },
          "want": {
            "$ref": "#/$defs/text"
          },
          "secret": {
            "$ref": "#/$defs/text",
            "description": "Hidden from the audience until a beat reveals it."
          },
          "voice": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "speech_style",
              "description"
            ],
            "properties": {
              "speech_style": {
                "$ref": "#/$defs/text",
                "description": "How they talk, for the writer."
              },
              "description": {
                "$ref": "#/$defs/text",
                "description": "Age, accent, timbre. Repeated in every clip prompt so the video model keeps the voice consistent; also picks the backup TTS voice."
              }
            }
          },
          "portrait_prompt": {
            "$ref": "#/$defs/text",
            "description": "Rendered once before the show into a reference image used for every clip."
          },
          "can_die_after_beat": {
            "oneOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "null"
              }
            ],
            "description": "Earliest beat id after which this character may die. null = never."
          }
        }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narration",
        "lines",
        "shots"
      ],
      "description": "Fixed first beat. Fully pre-rendered (clips + audio) before the show so there is no cold start.",
      "properties": {
        "narration": {
          "$ref": "#/$defs/text"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          },
          "minItems": 1
        },
        "shots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shot"
          },
          "minItems": 1,
          "maxItems": 4,
          "description": "Pre-rendered before the show."
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "description": "Live beats after the opening, in play order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "act",
          "purpose",
          "must_hit",
          "flexible",
          "max_words",
          "shots"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "act": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "purpose": {
            "$ref": "#/$defs/text",
            "description": "What this beat does for the story."
          },
          "must_hit": {
            "$ref": "#/$defs/text",
            "description": "Event that has to happen in this beat, whatever the crowd says."
          },
          "flexible": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            },
            "minItems": 1,
            "description": "What the crowd is allowed to steer here."
          },
          "max_words": {
            "type": "integer",
            "minimum": 40,
            "maximum": 400
          },
          "shots": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/shot"
            },
            "minItems": 1,
            "maxItems": 6,
            "description": "Anchor shots, as distinct camera setups. The live writer adapts them to the crowd and fills the rest of the chapter."
          }
        }
      }
    },
    "endings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "summary",
          "trigger_moods",
          "required_flags",
          "shots"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "summary": {
            "$ref": "#/$defs/text"
          },
          "trigger_moods": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "minItems": 1,
            "description": "Crowd moods that push the tally toward this ending."
          },
          "required_flags": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "state_seed.flags that must be true for this ending to be reachable."
          },
          "shots": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/shot"
            },
            "minItems": 1,
            "maxItems": 6,
            "description": "Pre-rendered before the show (may be chained for smooth continuity)."
          }
        }
      }
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "act",
          "actions"
        ],
        "properties": {
          "act": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            },
            "minItems": 1
          }
        }
      }
    },
    "state_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "mood",
        "flags",
        "clues",
        "relationships"
      ],
      "description": "Initial story state, right after the opening.",
      "properties": {
        "location": {
          "$ref": "#/$defs/text"
        },
        "mood": {
          "$ref": "#/$defs/id"
        },
        "flags": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "clues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "revealed"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "$ref": "#/$defs/text"
              },
              "revealed": {
                "type": "boolean"
              }
            }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "b",
              "trust"
            ],
            "properties": {
              "a": {
                "$ref": "#/$defs/id"
              },
              "b": {
                "$ref": "#/$defs/id"
              },
              "trust": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "bridges": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "description": "Short neutral fillers, pre-rendered as clips, played if the next beat is late. Must not advance the plot.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "narration",
          "shot"
        ],
        "properties": {
          "narration": {
            "$ref": "#/$defs/text"
          },
          "shot": {
            "$ref": "#/$defs/shot"
          }
        }
      }
    },
    "audience_hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phone_prompt",
        "seed_suggestions"
      ],
      "properties": {
        "phone_prompt": {
          "$ref": "#/$defs/text",
          "description": "Question shown above the text box on phones."
        },
        "seed_suggestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 3,
          "description": "Example comments to seed the feed when the room is quiet."
        }
      }
    }
  }
}
